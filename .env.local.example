# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key (safe to expose; database is read-only for this key via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key (SECRET - server only, never expose; used for score writes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PIN that tournament staff enter to unlock admin score reporting
ADMIN_PIN=1234
